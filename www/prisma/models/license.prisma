// ─── License Keys ─────────────────────────────────────────────────────────────

model License {
    id         String      @id @default(cuid())
    key        String      @unique @default(cuid()) // the actual license key shown to user
    userId     String
    productId  String
    purchaseId String      @unique
    type       LicenseType @default(INDIVIDUAL)

    // For team licenses — max seats
    maxSeats  Int @default(1)
    usedSeats Int @default(0)

    active    Boolean   @default(true)
    expiresAt DateTime? // null = lifetime

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user        User         @relation(fields: [userId], references: [id])
    product     Product      @relation(fields: [productId], references: [id])
    purchase    Purchase     @relation(fields: [purchaseId], references: [id])
    teamMembers TeamMember[]

    @@map("license")
}
